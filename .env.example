# Wazender — wasenderapi.com → Sessions → cliquer sur 🔑
WAZENDER_API_KEY=your-wazender-api-key

# OpenRouter — openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Supabase — supabase.com → ton projet → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Secret partagé du webhook — génère une valeur aléatoire forte (ex: openssl rand -hex 32)
# Doit être ajouté à l'URL configurée chez Wazender : https://ton-domaine/api/webhook?token=<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-to-a-strong-random-value

# Optionnel — modèle AI (défaut : anthropic/claude-sonnet-4-5)
# Autres exemples : openai/gpt-4o · google/gemini-2.0-flash-001
AI_MODEL=anthropic/claude-sonnet-4-5

# Optionnel — persona du bot (modifiable sans redéploiement via Vercel)
SYSTEM_PROMPT=You are a helpful assistant. Reply concisely. Always respond in the same language as the user.
